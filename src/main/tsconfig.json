{
  /* This config file is for the main process */
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "outDir": "../../dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,
    "tsBuildInfoFile": "../../dist/tsconfig.main.tsbuildinfo",
  },
  "include": [
    "./**/*",
    "../shared/**/*",
  ],
  "exclude": [
    "**/*.test.ts"
  ],
}
