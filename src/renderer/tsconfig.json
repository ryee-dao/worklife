{
  /* This config file is for the renderer process */
  "compilerOptions": {
    "target": "es2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@assets/*": [
        "../assets/*"
      ]
    },
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "composite": true,
    "tsBuildInfoFile": "../../dist/tsconfig.renderer.tsbuildinfo",
  },
  "include": [
    "./**/*",
    "../shared/**/*"
  ],
  "references": [
    {
      "path": "../main"
    }
  ],
}